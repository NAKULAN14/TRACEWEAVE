# ==============================
# TRACEWEAVE - Git Ignore
# ==============================

# --- Environment variables and secrets ---
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Python virtual environments ---
.venv/
venv/
env/
ENV/
backend/.venv/
frontend/.venv/

# --- Jupyter notebooks ---
.ipynb_checkpoints/

# --- Node.js / React / Vite ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- Local databases and database journals ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-shm
*.sqlite-wal

# --- Logs and temporary files ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- IDE and editor files ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace

# --- Generated investigation outputs ---
# Keep the reports directory and its documentation, but ignore generated output.
reports/*
!reports/.gitkeep
!reports/README.md

# --- Backend local evidence storage ---
backend/storage/evidence/
backend/storage/uploads/
backend/storage/temp/

# Keep local database files ignored; do not commit real case evidence.
backend/storage/*.db
backend/storage/*.sqlite
backend/storage/*.sqlite3

# --- Research experiment outputs ---
experiments/output/
experiments/outputs/
experiments/results/
experiments/checkpoints/
experiments/runs/
runs/
checkpoints/
*.h5
*.keras
*.ckpt
*.pt
*.pth
*.onnx
*.tflite

# --- Generated caches and reports ---
.cache/
.cache-*/
artifacts/
playwright-report/
test-results/
coverage/

# --- Preserve intentionally empty directories ---
# Add a .gitkeep file where an otherwise empty directory must be tracked.

# --- Local environment overrides ---
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
# Downloaded supplementary datasets
dataset/supplementary/phishtank.csv